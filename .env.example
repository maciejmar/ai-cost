# ============================================================
# Company AI OS — Konfiguracja środowiska
# Skopiuj do .env.agents, .env.gpu, .env.ovh i uzupełnij
# NIGDY nie commituj wypełnionych plików .env do Git!
# ============================================================

# ─── BAZA DANYCH (PostgreSQL) ───────────────────────────────
POSTGRES_DB=agentos
POSTGRES_USER=agentos
POSTGRES_PASSWORD=ZMIEN_NA_SILNE_HASLO_32_ZNAKI

# ─── REDIS ──────────────────────────────────────────────────
REDIS_PASSWORD=ZMIEN_NA_SILNE_HASLO_REDIS
REDIS_URL=redis://:ZMIEN_NA_SILNE_HASLO_REDIS@redis:6379/0

# ─── RABBITMQ ───────────────────────────────────────────────
RABBITMQ_USER=agentos
RABBITMQ_PASSWORD=ZMIEN_NA_SILNE_HASLO_RABBITMQ
RABBITMQ_URL=amqp://agentos:ZMIEN_NA_SILNE_HASLO_RABBITMQ@rabbitmq:5672/

# ─── LITELLM (GPU server) ───────────────────────────────────
LITELLM_MASTER_KEY=sk-ZMIEN_NA_UNIKALNY_KLUCZ_LITELLM
LITELLM_URL=http://10.10.0.3:4000   # WireGuard IP serwera GPU

# ─── AIGATEWAY-X ────────────────────────────────────────────
# Wygeneruj: make gateway-keys
GATEWAY_JWT_SECRET=ZMIEN_NA_LOSOWY_SECRET_MIN_32_ZNAKI
GATEWAY_ENCRYPTION_KEY=ZMIEN_NA_KLUCZ_FERNET          # szyfruje klucze upstream w bazie
GATEWAY_ALLOW_SIGNUP=false                             # pierwsze konto (admin) można założyć zawsze
GATEWAY_COOKIE_SECURE=true
GATEWAY_ALLOW_ENV_CREDENTIALS=false                    # true = ANTHROPIC/OPENAI_API_KEY poniżej jako zapas
USD_PLN_RATE=4.00
# Agenci wołający LLM przez bramkę (BaseAgent.call_llm):
GATEWAY_URL=http://gateway:8090
GATEWAY_APP_KEY=                                       # klucz agx_… z dashboardu; X-App-ID = AGENT_NAME

# ─── LLM API KEYS ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-TWOJ_KLUCZ_ANTHROPIC
OPENAI_API_KEY=sk-TWOJ_KLUCZ_OPENAI           # fallback

# ─── LANGFUSE ───────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-TWOJ_KLUCZ_PUBLICZNY
LANGFUSE_SECRET_KEY=sk-lf-TWOJ_KLUCZ_PRYWATNY
LANGFUSE_HOST=http://10.10.0.3:3000            # WireGuard IP serwera GPU
LANGFUSE_DB_PASSWORD=ZMIEN_NA_SILNE_HASLO_LANGFUSE_DB
LANGFUSE_CLICKHOUSE_PASSWORD=ZMIEN_NA_SILNE_HASLO_CH
LANGFUSE_NEXTAUTH_SECRET=ZMIEN_NA_LOSOWY_SECRET_32_ZNAKI
LANGFUSE_SALT=ZMIEN_NA_LOSOWY_SALT_32_ZNAKI

# ─── TWILIO / WHATSAPP ──────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886     # Twilio sandbox / produkcyjny numer
OWNER_WHATSAPP_NUMBERS=whatsapp:+48NUMER1,whatsapp:+48NUMER2

# ─── GITHUB ─────────────────────────────────────────────────
GITHUB_TOKEN=ghp_TWOJ_TOKEN_GITHUB
GITHUB_ORG=TWOJA_ORGANIZACJA_LUB_USER
GITHUB_API_URL=https://api.github.com

# ─── COST GATE PROGI (USD) ──────────────────────────────────
COST_GATE_GREEN=0.50        # < $0.50 → auto-approve
COST_GATE_AMBER=5.00        # $0.50–$5.00 → WhatsApp approval
# > $5.00 → blokada

# ─── BUDŻETY (USD) ──────────────────────────────────────────
BUDGET_DAILY_PER_AGENT=10.00
BUDGET_DAILY_GLOBAL=50.00
BUDGET_MONTHLY_CAP=500.00

# ─── KEYCLOAK ───────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=ZMIEN_NA_SILNE_HASLO_KEYCLOAK
KEYCLOAK_URL=https://auth.TWOJA_DOMENA
KEYCLOAK_REALM=agentos
KEYCLOAK_CLIENT_ID=agents
KEYCLOAK_CLIENT_SECRET=ZMIEN_NA_KLUCZ_KEYCLOAK

# ─── GRAFANA ────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=ZMIEN_NA_SILNE_HASLO_GRAFANA

# ─── DOMENY ─────────────────────────────────────────────────
BASE_DOMAIN=webaby.io
VPS_PUBLIC_IP=PUBLICZNY_IP_VPS_OVH

# ─── WIREGUARD (wypełniane na każdej maszynie) ───────────────
WG_OVH_IP=10.10.0.1        # VPS OVH
WG_WEBABY_IP=10.10.0.2     # Serwer webaby
WG_GPU_IP=10.10.0.3        # Serwer GPU

# ─── STRIPE (Faza 4) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_TWOJ_KLUCZ_STRIPE
STRIPE_WEBHOOK_SECRET=whsec_TWOJ_SECRET_WEBHOOK

# ─── GOOGLE PLAY (Faza 4) ───────────────────────────────────
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/run/secrets/google_play_sa.json

# ─── SENTRY ─────────────────────────────────────────────────
SENTRY_DSN=https://TWOJ_DSN@sentry.io/PROJECT_ID

# ─── ADMOB (Android) ────────────────────────────────────────
ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
