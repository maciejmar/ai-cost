# AIGateway-X (ai-cost.webaby.io) — szablon pliku /opt/agentic-ai-os/.env.agents na serwerze
# Wartości ZMIEN_… wygeneruj komendami z komentarzy. Gateway odmówi startu z zaślepkami.

# Baza danych — openssl rand -hex 24
POSTGRES_PASSWORD=ZMIEN_NA_LOSOWE_HASLO

# Redis — openssl rand -hex 24; to samo hasło w REDIS_URL
REDIS_PASSWORD=ZMIEN_NA_LOSOWE_HASLO
REDIS_URL=redis://:ZMIEN_NA_LOSOWE_HASLO@redis:6379/0

# Sesje logowania — openssl rand -hex 32
GATEWAY_JWT_SECRET=ZMIEN_NA_LOSOWY_SECRET

# Szyfrowanie kluczy OpenAI/Anthropic w bazie — openssl rand -base64 32 | tr '+/' '-_'
# Zrób kopię! Bez tego klucza zapisane klucze providerów są nie do odczytania.
GATEWAY_ENCRYPTION_KEY=ZMIEN_NA_KLUCZ_FERNET

# Porty na serwerze (8090 zajmuje inny kontener) — muszą się zgadzać z nginx/ai-cost.webaby.io.conf
GATEWAY_HOST_PORT=8190
GATEWAY_UI_HOST_PORT=3190

# Ustawienia
GATEWAY_ALLOW_SIGNUP=false      # pierwsze konto (admin) można założyć zawsze
GATEWAY_COOKIE_SECURE=true
USD_PLN_RATE=4.00

# Lokalne modele przez LiteLLM na serwerze GPU — puste = wyłączone
LITELLM_URL=
LITELLM_MASTER_KEY=
